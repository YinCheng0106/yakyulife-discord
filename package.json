{
  "name": "yakyulife-discord",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/bot/src/index.ts",
    "start": "bun dist/bot.js",
    "build": "bun build apps/bot/src/index.ts --target=bun --outdir=dist --entry-naming=bot.js --sourcemap=linked --external sharp",
    "test": "bun test packages tests",
    "test:integration": "bun test tests/integration",
    "test:simulation": "bun run scripts/simulate.ts",
    "toolchain:verify": "bun run scripts/verify-toolchain.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run toolchain:verify && bun run typecheck && bun run lint && bun test && bun run test:simulation && bun run build",
    "db:generate": "bunx supabase migration new",
    "db:doctor": "bun run scripts/db-doctor.ts",
    "db:use-session-pooler": "bun run scripts/use-linked-session-pooler.ts",
    "db:verify": "bun run scripts/db-verify.ts",
    "db:push": "bun run scripts/db-push.ts",
    "db:push:dry-run": "bun run scripts/db-push.ts --dry-run",
    "discord:deploy": "bun run scripts/deploy-commands.ts",
    "upstream:check": "bun run scripts/upstream-check.ts"
  },
  "dependencies": {
    "@yakyulife/core": "workspace:*",
    "@yakyulife/discord": "workspace:*",
    "@yakyulife/postgres": "workspace:*",
    "discord.js": "14.26.4",
    "sharp": "0.34.3",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.14",
    "@types/signale": "1.4.7",
    "supabase": "2.114.0",
    "typescript": "5.9.2"
  }
}
