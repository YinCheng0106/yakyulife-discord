# Discord application credentials
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: deploy commands to a test guild immediately. Omit for global commands.
DISCORD_GUILD_ID=

# Supabase Postgres connection. Use direct connection on IPv6 or Supavisor session mode on IPv4.
DATABASE_URL=
# Optional alternative to `supabase link`: admin connection used only by db:push. Must have DDL permission.
MIGRATION_DATABASE_URL=

# Runtime
PORT=3000
LOG_LEVEL=info
